# Sao chep file nay thanh ".env" truoc khi chay local.
# Gemini chi la fallback khi file khong nhan dien duoc bang mapping thu cong,
# preset, mapping chuan Pharmacity hoac cache. Co the de trong neu chi dung cac
# luong mapping da nhan dien duoc; khi can AI, dien API key thuc te vao day.
GEMINI_API_KEY=

# Tai khoan mo khoa toan bo cong cu quan tri. Khach khong can dang nhap va chi
# thay chuc nang kiem tra han dung.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_a_strong_password
# Chuoi ngau nhien dai, khac mat khau. Vi du tao bang: openssl rand -hex 32
ADMIN_SESSION_SECRET=change_this_to_a_long_random_secret
ADMIN_TOKEN_TTL_SECONDS=43200

# Tong so tac vu CTKM/Tem R gom 1 dang chay va cac tac vu dang cho.
HEAVY_JOB_QUEUE_SIZE=5
# Kiem tra han dung chay song song va cache so file ton kho gan nhat theo gia tri nay.
EXPIRATION_CONCURRENCY=5
EXPIRATION_CACHE_SIZE=1

# Gioi han upload; XLSX con duoc kiem tra cau truc/resource truoc khi xu ly.
MAX_EXPIRATION_FILE_MB=20
MAX_TEM_R_FILE_MB=25
MAX_PIPELINE_FILE_MB=50
JOB_TTL_SECONDS=21600

# Staff scheduling persistence.
# Production Cloud Run: set SCHEDULE_GCS_BUCKET to a bucket the service account can read/write.
# Optional object path defaults to ctkm/schedules.json.
SCHEDULE_GCS_BUCKET=
SCHEDULE_GCS_OBJECT=ctkm/schedules.json
# Local/dev fallback only. Mark durable=true ONLY when this path is on a real persistent mount.
SCHEDULE_STORE_PATH=
SCHEDULE_STORE_DURABLE=false
